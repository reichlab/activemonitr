Package: activeMonitr
Title: Evaluating public health active monitoring
Version: 0.0.3
Authors@R: c(
    person(c("Nicholas", "G."), "Reich", , "nick@umass.edu", role = c("aut", "cre")), 
    person(c("Stephen", "A."), "Lauer", , "slauer5@jh.edu", role = c("ctb")),
    person("Xuelian", "Li", , , role = c("aut"))
